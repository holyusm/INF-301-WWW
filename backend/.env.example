# Base de datos PostgreSQL
# En Railway: usa el valor de DATABASE_URL que genera el plugin de PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/fukusuke_db

# JWT
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Entorno
# En Railway setear a: production
NODE_ENV=development
PORT=3000
